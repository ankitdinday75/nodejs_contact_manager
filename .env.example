# Exchange (CoinDCX by default)

EXCHANGE=coindcx
API_KEY=
API_SECRET=

# Trading (paper defaults)

QUOTE_BALANCE=1000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
LEVERAGE=1
TAKE_PROFIT_PCT=0.02
STOP_LOSS_PCT=0.01
TIMEZONE=Asia/Kolkata

# Model path for live inference (created by pipeline)

MODEL_PATH=models/xgb_SOLUSDT_1h.pkl
FEATURE_WINDOW=200     # candles to compute indicators in live
PRED_THRESHOLD=0.55
EXIT_THRESHOLD=0.45
